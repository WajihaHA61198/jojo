{%- comment -%} theme.fbt {%- endcomment -%}
{% if product.metafields.custom.fbt.value != null %}
  <script src="{{ 'fbt.js' | asset_url }}" defer="defer"></script>
  {%- liquid
    assign se_id = section.id
    assign form_id = 't4s-fbt__frm' | append: se_id
    assign product_list = product.metafields.custom.fbt.value
  -%}

  {%- for i in (1..1) -%}
    {%- liquid
      assign pid = product.id
      assign current_variant = product.selected_or_first_available_variant
      assign current_variant_id = current_variant.id
    -%}

    {{ 'fbt.css' | asset_url | stylesheet_tag }}

    <div class="t4s-fbt__wrap t4s-container sadsdasds">
      {% comment %}<h3 class="t4s-fbt__title">{{ 'products.fbt.title' | t }}</h3>  {% endcomment %}
      <h3 class="t4s-fbt__title">Complete the look</h3>
      <div class="t4s-fbt__products">
        {%- form 'product',
          product,
          id: form_id,
          class: 't4s-fbt__frm',
          novalidate: 'novalidate',
          data-groups-pr-form: '',
          data-type: 'add-to-cart-form'
        -%}
          <div class="">
            <div class="t4s-col-auto t4s-col-item is--col-fbt-img  t4s-d-flex t4s-flex-wrap t4s-align-items-center t4s-fbt__list-img">
              {%- liquid
                assign price = current_variant.price
                assign compare_pr = current_variant.compare_at_price | default: price
                assign image = current_variant.featured_image | default: product.featured_image
                assign img_url = image | image_url: width: 400
              -%}

              <div class="t4s-fbt__img t4s-fbt_img-0 t4s-pr" data-groups-img="{% increment indexData %}">
                <img
                  class="lazyloadt4s t4s-lz--fadeIn"
                  data-src="{{ image | image_url: width: 600 }}"
                  src="{{ image | image_url: width: 60 }}"
                  alt="{{ image.alt | escape }}"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                >
              </div>

              {%- for item in product_list -%}
                {%- liquid
                  if pid == item.id or item.available == false
                    continue
                  endif
                  assign current_variant_item = item.selected_or_first_available_variant
                  assign cu_pr = current_variant_item.price
                  assign cp_pr = current_variant_item.compare_at_price | default: cu_pr
                  assign price = price | plus: cu_pr
                  assign compare_pr = compare_pr | plus: cp_pr
                  assign image = current_variant_item.featured_image | default: item.featured_image
                  assign img_url = image | image_url: width: 400
                -%}

                <div
                  class="t4s-fbt__img t4s-fbt_img{% decrement index %} t4s-pr"
                  data-groups-img="{% increment indexData %}"
                >
                  <svg focusable="false" class="t4s-svg t4s-svg--plus" viewBox="0 0 10 10" role="presentation">
                    <path d="M6 4h4v2H6v4H4V6H0V4h4V0h2v4z" fill="currentColor" fill-rule="evenodd"></path>
                  </svg>
                  <a href="{{ item.url }}" class="">
                    <img
                      class=""
                      data-src="{{ image | image_url: width: 600 }}"
                      src="{{ image | image_url: width: 60 }}"
                      alt="{{ image.alt | escape }}"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                    >
                  </a>
                </div>
              {%- endfor -%}
            </div>

            <ul class="t4s-fbt__swatches">
              {%- liquid
                assign available_v = product.variants | where: 'available'
                assign available_v_1 = available_v.first
                assign featured_image = product.featured_image
              -%}
              {%- liquid
                assign cus_qty = product.metafields.theme.cus_qty | default: 1
                if available_v_1.quantity_rule.min and cus_qty < available_v_1.quantity_rule.min
                  assign cus_qty = available_v_1.quantity_rule.min
                endif
              -%}
              <li data-groups-pr-item class="JJ t4s-fbt__item t4s-fbt_item-0 is--checked">
                <span>
                  <input
                    data-groups-pr-ck
                    autocomplete="off"
                    type="checkbox"
                    checked="checked"
                    id="t4s-fbt_ck_0{{ se_id }}"

                  ><label for="t4s-fbt_ck_0{{ se_id }}" class="t4s-pr t4s-pe-none t4s-d-inline-block">
                    <svg class="t4s-dn t4s-icon_checked" viewBox="0 0 24 24">
                      <path d="M9 20l-7-7 3-3 4 4L19 4l3 3z"></path>
                    </svg>
                  </label>

                  <span class="pr_title"
                    ><strong>This item:</strong> {{ product.title | truncatewords: 12 -}}
                    {%- if available_v.size < 2 and product.has_only_default_variant == false %}
                      - {{ available_v_1.title -}}
                    {%- endif -%}
                  </span>
                </span>

                {%- if available_v.size < 2 -%}
                  <input
                    data-groups-pr-sl
                    name="items[][id]"
                    data-cpprice="{{ available_v_1.compare_at_price | default: available_v_1.price }}"
                    data-price="{{ available_v_1.price }}"
                    value="{{ available_v_1.id }}"
                    type="hidden"
                  >
                {%- else -%}
                  <select
                    data-groups-pr-sl
                    name="items[][id]"
                    autocomplete="off"
                    data-cpprice="{{ available_v_1.compare_at_price | default: available_v_1.price }}"
                    data-price="{{ available_v_1.price }}"
                  >
                    {%- for variant in available_v -%}
                      <option
                        data-img="{{ variant.image | default: featured_image | image_url: width: 1 }}"
                        data-cpprice="{{ variant.compare_at_price | default: variant.price }}"
                        data-price="{{ variant.price }}"
                        data-max="{% if variant.inventory_management == blank or variant.inventory_policy == 'continue' %}9999{% else %}{{ variant.inventory_quantity | default: 9999 }}{% endif %}"
                        value="{{ variant.id }}"
                        {% if variant.id == current_variant_id %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ variant.title | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- endif -%}
                {% comment %} <br> {% endcomment %}
                <input
                  data-groups-qty-value
                  value="{{ cus_qty }}"
                  type="number"
                  name="items[][quantity]"
                  class="t4s-d-none"
                >
                <div>
                  <span class="t4s-fbt__price" data-groups-item-price>
                    {%- if available_v_1.compare_at_price > available_v_1.price -%}
                      <del>{{ available_v_1.compare_at_price | money }}</del>
                      <ins>{{ available_v_1.price | money }}</ins>
                    {%- else -%}
                      {{- available_v_1.price | money -}}
                    {%- endif -%}
                  </span>
                </div>
              </li>

              {%- assign index = 0 -%}
              {%- for item in product_list -%}
                {%- liquid
                  if pid == item.id or item.available == false
                    continue
                  endif
                  assign index = index | plus: 1
                  assign available_v = item.variants | where: 'available'
                  assign available_v_1 = available_v.first
                  assign featured_image = item.featured_image
                -%}
                <li data-groups-pr-item class="JJ2 t4s-fbt__item t4s-fbt_item-{{ index }} is--checked">
                  <span>
                    <input
                      data-groups-pr-ck
                      autocomplete="off"
                      type="checkbox"
                      checked="checked"
                      id="t4s-fbt_ck{{ index }}{{ se_id }}"
                    >
                    <label for="t4s-fbt_ck{{ index }}{{ se_id }}" class="t4s-pr t4s-d-inline-block">
                      <svg class="t4s-dn t4s-icon_checked" viewBox="0 0 24 24">
                        <path d="M9 20l-7-7 3-3 4 4L19 4l3 3z"></path>
                      </svg>
                    </label>
                    <a class="t4s-fbt__link pr_title" href="{{ item.url }}">
                      {{- item.title | truncatewords: 12 -}}
                      {%- if available_v.size < 2 and item.has_only_default_variant == false %}
                        - {{ available_v_1.title -}}
                      {%- endif -%}
                    </a>
                  </span>

                  {%- if available_v.size < 2 -%}
                    <input
                      data-groups-pr-sl
                      name="items[][id]"
                      data-cpprice="{{ available_v_1.compare_at_price | default: available_v_1.price }}"
                      data-price="{{ available_v_1.price }}"
                      value="{{ available_v_1.id }}"
                      type="hidden"
                    >
                  {%- else -%}
                    <select
                      data-groups-pr-sl
                      name="items[][id]"
                      autocomplete="off"
                      data-cpprice="{{ available_v_1.compare_at_price | default: available_v_1.price }}"
                      data-price="{{ available_v_1.price }}"
                    >
                      {%- for variant in available_v -%}
                        <option
                          data-img="{{ variant.image | default: featured_image | image_url: width: 1 }}"
                          data-cpprice="{{ variant.compare_at_price | default: variant.price }}"
                          data-price="{{ variant.price }}"
                          data-max="{% if variant.inventory_management == blank or variant.inventory_policy == 'continue' %}9999{% else %}{{ variant.inventory_quantity | default: 9999 }}{% endif %}"
                          value="{{ variant.id }}"
                          {% if variant.id == current_variant_id %}
                            selected="selected"
                          {% endif %}
                        >
                          {{ variant.title | escape }}
                        </option>
                      {%- endfor -%}
                    </select>
                  {%- endif -%}
                  <br>
                  <input data-groups-qty-value value="1" type="number" name="items[][quantity]" class="t4s-d-none">
                  <span class="t4s-fbt__price" data-groups-item-price>
                    {%- if available_v_1.compare_at_price > available_v_1.price -%}
                      <del>{{ available_v_1.compare_at_price | money }}</del>
                      <ins>{{ available_v_1.price | money }}</ins>
                    {%- else -%}
                      {{- available_v_1.price | money -}}
                    {%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
            </ul>

            <div class="t4s-col-auto t4s-col-item is--col-fbt-total-price">
              <div class="t4s-fbt__text-total-price">
                <span class="t4s-fbt_total-text" style="margin-right:1rem;">Total price:</span
                ><span class="t4s-fbt_total-price WAJIHA" data-groups-total-price>
                  {%- if compare_pr > price -%}
                    <del>{{ compare_pr | money_without_trailing_zeros }}</del>
                    <ins>{{ price | money_without_trailing_zeros }}</ins>
                  {%- else -%}
                    {{- price | money_without_trailing_zeros -}}
                  {%- endif -%}
                </span>
              </div>

              <button
                {% comment %} onclick="addToCart()" {% endcomment %}
                onclick="updateDivss()"
                id="ProductSubmitButton-{{ section.id }}"
                class="product-form__submit button button--full-width button--secondary   t4s-fbt__submit t4s-btn-loading__svg"
                style="background-color:black;"
                type="submit"
                name="add"
                data-atc-form
              >
                <span class="t4s-btn-atc_text">add to cart</span>
                <span class="t4s-loading__spinner" hidden>
                  <svg
                    width="16"
                    height="16"
                    hidden
                    class="t4s-svg-spinner"
                    focusable="false"
                    role="presentation"
                    viewBox="0 0 66 66"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle class="t4s-path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                  </svg>
                </span>
              </button>
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>
  {%- endfor -%}

  <script>
    document.addEventListener("DOMContentLoaded", function () {
  const fbtSection = document.querySelector(".t4s-fbt__wrap");
  if (!fbtSection) return;

  const form = fbtSection.querySelector("form[data-groups-pr-form]");
  if (!form) return;

  const checkboxes = form.querySelectorAll("[data-groups-pr-ck]");
  const totalEl = fbtSection.querySelector("[data-groups-total-price]");
  const submitBtnContainer = fbtSection.querySelector(".t4s-col-auto.is--col-fbt-total-price");
  const submitBtn = form.querySelector('[type="submit"]');
  const btnText = submitBtn?.querySelector('.t4s-btn-atc_text');
  const spinner = submitBtn?.querySelector('.t4s-loading__spinner');

  // --- Lock main product checkbox
  const mainCheckbox = checkboxes[0];
  if (mainCheckbox) {
    mainCheckbox.checked = true;
    mainCheckbox.disabled = true;
  }

 // --- Create error message element below total price and above submit button
let errorEl = document.createElement("div");
errorEl.className = "t4s-fbt__error-message";
errorEl.style.color = "red";
errorEl.style.margin = "5px 0";
errorEl.style.fontWeight = "bold";
errorEl.style.display = "none";
submitBtnContainer.insertBefore(errorEl, submitBtn);

// --- Function to show error and hide after 5 seconds
function showError(message) {
  errorEl.innerText = message;
  errorEl.style.display = "block";
  setTimeout(() => {
    errorEl.style.display = "none";
  }, 5000);
}

  // --- Format money
  function formatMoney(cents) {
    const amount = cents / 100;
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: {{ shop.currency | json }},
    }).format(amount);
  }

  // --- Recalculate total
  // --- Recalculate total & toggle images
function recalcTotal() {
  let total = 0;
  checkboxes.forEach((ck, idx) => {
    const item = ck.closest("[data-groups-pr-item]");
    const price = parseInt(item.querySelector("[data-price]")?.dataset.price || 0);

    // Toggle image visibility
    const imgLi = fbtSection.querySelector(`.t4s-fbt__list-img li[data-groups-img="${idx}"]`);
    if (imgLi) {
      if (ck.checked) {
        imgLi.classList.remove("is-hiding", "is-hidden");
        setTimeout(() => imgLi.classList.remove("is-hiding"), 10); // fade-in animation
      } else {
        imgLi.classList.add("is-hiding");
        setTimeout(() => imgLi.classList.add("is-hidden"), 350); // after transition
      }
    }

    if (ck.checked) total += price;
  });

  if (totalEl) totalEl.innerHTML = formatMoney(total);
}

checkboxes.forEach((ck) => ck.addEventListener("change", recalcTotal));


  // --- Handle FBT Add to Cart with quantity check
  form.addEventListener("submit", async function (e) {
    e.preventDefault();

    // --- Reset error message
    errorEl.style.display = "none";
    errorEl.innerText = "";

    // --- Get main product quantity
    const mainItem = form.querySelector("[data-groups-pr-item]");
    const mainQtyInput = mainItem?.querySelector('[name="items[][quantity]"]');
    const mainQty = parseInt(mainQtyInput?.value || 0);

    const available_v = mainItem ? mainItem.querySelectorAll("option, [data-price]") : [];
    let minQty = 1;

    // Attempt to get min quantity from variant data
    const selectedOption = mainItem?.querySelector("select");
    if (selectedOption) {
      const selected = selectedOption.selectedOptions[0];
      if (selected && selected.dataset.min) {
        minQty = parseInt(selected.dataset.min, 10);
      }
    }

    // --- Check quantity
    if (mainQty < minQty) {
      errorEl.innerText = `Minimum quantity for this product is ${minQty}.`;
      errorEl.style.display = "block";
      return;
    }

    // --- Collect items to add
    const itemsToAdd = [];
    form.querySelectorAll("[data-groups-pr-item]").forEach((item) => {
      const ck = item.querySelector("[data-groups-pr-ck]");
      if (!ck.checked) return;

      const variantInput = item.querySelector('[name="items[][id]"]');
      const qtyInput = item.querySelector('[name="items[][quantity]"]');
      if (variantInput && qtyInput) {
        itemsToAdd.push({
          id: parseInt(variantInput.value, 10),
          quantity: parseInt(qtyInput.value, 10) || 1,
        });
      }
    });

    if (!itemsToAdd.length) return;

    // --- Button loading state
    submitBtn.disabled = true;
    if (btnText) btnText.hidden = true;
    if (spinner) spinner.hidden = false;

    try {
      const response = await fetch("/cart/add.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ items: itemsToAdd }),
      });

      if (response.ok) {
        await refreshCartDrawer();
      } else {
        const errText = await response.text();
        console.error("FBT add failed:", errText);
        {% comment %} errorEl.innerText = "The maximum quantity of this item is already in your cart."; {% endcomment %}
        showError("The maximum quantity of this item is already in your cart.");
      }
    } catch (err) {
      console.error("FBT add error:", err);
      errorEl.innerText = "Failed to add products to cart.";
      errorEl.style.display = "block";
    }

    // --- Reset button
    submitBtn.disabled = false;
    if (btnText) btnText.hidden = false;
    if (spinner) spinner.hidden = true;
  });

  // --- Refresh & open Dawn cart drawer
  async function refreshCartDrawer() {
    const cartDrawer = document.querySelector("cart-drawer");
    if (!cartDrawer) return;

    const cartResponse = await fetch("/cart.js");
    const cart = await cartResponse.json();

    const cartCountBubbles = document.querySelectorAll(".cart-count-bubble, [data-ajax-cart-bubble]");
    cartCountBubbles.forEach(bubble => {
      const countElement = bubble.querySelector(".quantity, span") || bubble;
      if (countElement) countElement.textContent = cart.item_count;
    });

    const html = await fetch("/cart?section_id=cart-drawer").then(r => r.text());
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, "text/html");
    const newCartDrawer = doc.querySelector("cart-drawer");

    if (newCartDrawer) {
      cartDrawer.innerHTML = newCartDrawer.innerHTML;
      cartDrawer.classList.remove('is-empty');
    }

    initializeClickOutsideClose(cartDrawer);

    if (typeof cartDrawer.open === "function") cartDrawer.open();
  }

  function initializeClickOutsideClose(cartDrawer) {
    if (cartDrawer._clickOutsideHandler) {
      document.removeEventListener('click', cartDrawer._clickOutsideHandler);
    }

    cartDrawer._clickOutsideHandler = function(event) {
      const isClickInsideDrawer = cartDrawer.contains(event.target);
      const isCartIcon = event.target.closest('.header__icon--cart, [data-drawer-toggle="cart"]');
      
      if (!isClickInsideDrawer && !isCartIcon && cartDrawer.hasAttribute('open')) {
        if (typeof cartDrawer.close === "function") cartDrawer.close();
        else {
          cartDrawer.removeAttribute('open');
          cartDrawer.classList.remove('active');
          document.body.classList.remove('overflow-hidden-mobile');
        }
      }
    };

    document.addEventListener('click', cartDrawer._clickOutsideHandler);

    const overlay = cartDrawer.querySelector('.cart-drawer__overlay');
    if (overlay) overlay.addEventListener('click', () => cartDrawer.close?.());

    const closeButton = cartDrawer.querySelector('.drawer__close');
    if (closeButton) closeButton.addEventListener('click', () => cartDrawer.close?.());
  }
});
  </script>
{% endif %}
