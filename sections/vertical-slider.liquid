{{ 'vertical-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vertical.js' | asset_url }}" defer="defer"></script>

<section class="vertical-slider">
  <div class="vs-wrapper">
    {% for block in section.blocks %}
      {% comment %}
        <div class="vs-slide" style="background-image: url({{ block.settings.image | img_url: '1600x' }})">
          <div class="vs-content">
            <h2>{{ block.settings.heading }}</h2>
          </div>
          <a
            href="{{ block.settings.banner_link | default: routes.all_products_collection_url }}"
            class="sr4-full-width-link"
          ></a>
        </div>
      {% endcomment %}
      <div class="vs-slide">
        {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
        {% comment %}
          <picture>
            <!-- mobile first -->
            {% if block.settings.image_mobile != blank %}
              <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | img_url: '800x' }}">

            {% else %}
              {% if placeholder_slide == 1 %}
                {{ 'hero-apparel-2' | placeholder_svg_tag: 'parallax-img desktop-only' }}
              {% else %}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'parallax-img desktop-only' }}
              {% endif %}
            {% endif %}
            <!-- fallback desktop -->
            <img src="{{ block.settings.image | img_url: '1600x' }}" alt="{{ block.settings.heading | escape }}">
          </picture>
        {% endcomment %}

        <picture>
          <!-- Mobile Image -->
          {% if block.settings.image_mobile != blank %}
            <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | img_url: '800x' }}">
          {% endif %}

          <!-- Desktop & Fallback -->
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | img_url: '1600x' }}"
              alt="{{ block.settings.heading | escape }}"
              loading="lazy"
            >
          {% else %}
            {% if placeholder_slide == 1 %}
              {{ 'hero-apparel-2' | placeholder_svg_tag: 'parallax-svg' }}
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'parallax-svg' }}
            {% endif %}
          {% endif %}
        </picture>

        <div class="vs-content">
          <h2>{{ block.settings.heading }}</h2>
        </div>
        <a
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          class="sr4-full-width-link"
        ></a>
      </div>
    {% endfor %}
  </div>

  <div class="vs-dots">
    {% for block in section.blocks %}
      <span class="vs-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></span>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Vertical Slider",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Linking"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Vertical Slider",
      "category": "Image",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
